# Copy this file to ".env" and fill in your own values. Never commit .env to GitHub.
# Every value is optional: anything left empty is simply switched off and the game still works.

# Supabase → Project Settings → API Keys: the Project URL and the PUBLISHABLE key (sb_publishable_...)
# (older projects: the "anon public" key works too). NEVER put the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AdSense publisher ID, after you're approved for H5 Games Ads (looks like ca-pub-1234567890123456)
VITE_ADSENSE_CLIENT=

# Supporter pack payments through Bachs (bachs.io). Set to true AFTER deploying the bachs-checkout and
# bachs-webhook functions. Bachs keys are secret: they go into Supabase secrets, never into this file.
VITE_PAYMENTS_ENABLED=
